*/
/*
  Example content:
*/
/*
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  X-Frame-Options: DENY
  X-XSS-Protection: 0
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self' https:; img-src 'self' data: https:; connect-src 'self' https://www.omdbapi.com; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; base-uri 'self'; frame-ancestors 'none'
